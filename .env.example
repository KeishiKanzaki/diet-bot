# Never commit production secrets. Inject via your hosting provider.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
# Default false: blocks ALL Gemini requests, even with an API key present.
# Set true only after verifying the project's Free tier in Google AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
# Optional override. Defaults to the model verified in the existing deployment.
GEMINI_MODEL=gemini-3-flash-preview
SUPABASE_URL=
# Backend-only service_role key. Never expose in a browser or LINE message.
SUPABASE_KEY=
DAILY_AI_LIMIT=10
# Published policy with operator identity, contact, data handling and retention.
PRIVACY_URL=
PORT=5000
